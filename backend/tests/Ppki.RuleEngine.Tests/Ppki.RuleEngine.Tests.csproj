<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../services/Ppki.Api/Ppki.Api.csproj" />
    <ProjectReference Include="../../services/Ppki.Worker/Ppki.Worker.csproj" />
    <ProjectReference Include="../../src/Ppki.DocxEngine/Ppki.DocxEngine.csproj" />
    <ProjectReference Include="../../src/Ppki.Domain/Ppki.Domain.csproj" />
    <ProjectReference Include="../../src/Ppki.FixEngine/Ppki.FixEngine.csproj" />
