{
  "name": "ppki-smart-formatter-supabase-tools",
  "private": true,
  "scripts": {
    "verify": "node scripts/developer.mjs verify",
    "test:developer": "node --test scripts/developer.test.mjs",
    "test:dev-bootstrap": "node --test scripts/dev-bootstrap.test.mjs",
    "test:secret-hygiene": "node --test scripts/secret-scan.test.mjs",
    "test:migrations": "node --test scripts/migration-check.test.mjs",
    "test:rls-local": "node scripts/rls-smoke-test.mjs",
    "test:storage-local": "node scripts/storage-smoke-test.mjs",
    "test:immutability-local": "node scripts/immutability-smoke-test.mjs",
    "test:audit-trail-local": "node scripts/audit-trail-smoke-test.mjs",
    "test:security-integration-local": "node scripts/security-integration-test.mjs",
    "test:fix-execution-local": "node scripts/fix-execution-smoke-test.mjs",
    "test:reaudit": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj -c Release --filter FullyQualifiedName~Reaudit",
    "test:reaudit-local": "node scripts/reaudit-smoke-test.mjs",
    "test:audit-comparison": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj -c Release --filter FullyQualifiedName~AuditComparison",
    "test:audit-comparison-local": "node scripts/audit-comparison-smoke-test.mjs",
    "test:finding-resolution": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj -c Release --no-restore --filter FullyQualifiedName~FindingResolution",
    "test:finding-resolution-local": "node scripts/finding-resolution-smoke-test.mjs",
    "test:finding-review": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj -c Release --no-restore --filter FullyQualifiedName~FindingReview",
    "test:finding-review-local": "node scripts/finding-review-smoke-test.mjs && node scripts/finding-resolution-smoke-test.mjs",
    "check:secrets": "node scripts/secret-scan.mjs",
    "check:migrations": "node scripts/migration-check.mjs",
    "fixtures:generate": "dotnet run --project backend/tools/Ppki.FixtureGenerator/Ppki.FixtureGenerator.csproj -- --output backend/tests/fixtures/docx/generated",
    "fixtures:check": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj --filter FullyQualifiedName~DocxFixture",
    "test:docx-parser": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj --filter FullyQualifiedName~DocxParser",
    "test:layout-validators": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj --filter FullyQualifiedName~LayoutValidator",
    "test:wave1-validators": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj --filter \"FullyQualifiedName~LayoutValidator|FullyQualifiedName~Wave1\"",
    "test:audit-read-model": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj --filter FullyQualifiedName~AuditRead",
    "test:scoring": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj --filter FullyQualifiedName~AuditScoring",
    "test:fix-plan-preview": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj -c Release --filter FullyQualifiedName~FixPlanPreview",
    "test:fix-apply": "dotnet test backend/tests/Ppki.RuleEngine.Tests/Ppki.RuleEngine.Tests.csproj -c Release --filter \"FullyQualifiedName~FixApply|FullyQualifiedName~FixExecution|FullyQualifiedName~BodyJustified\"",
    "test:findings-ui": "npm run --prefix apps/web test:findings-ui",
    "dev:prerequisites": "node scripts/developer.mjs prerequisites",
    "dev:infra": "node scripts/dev-bootstrap.mjs infra",
    "dev:api": "node scripts/dev-bootstrap.mjs api",
    "dev:worker": "node scripts/dev-bootstrap.mjs worker",
    "dev:backend": "node scripts/dev-bootstrap.mjs backend",
    "dev:web": "node scripts/dev-bootstrap.mjs web",
    "dev:status": "node scripts/dev-bootstrap.mjs status",
    "dev:stop": "node scripts/dev-bootstrap.mjs stop",
    "dev:up": "npm run dev:infra",
    "dev:down": "npm run dev:stop"
  },
  "devDependencies": { "supabase": "2.111.0" }
}
